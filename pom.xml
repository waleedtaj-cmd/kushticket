<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ticketbot</groupId>
    <artifactId>kushticket</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>
    <name>KushTicket</name>

    <properties>
        <!-- Java 21 -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            JDA 6.3.0+ هو أول إصدار يدعم بروتوكول DAVE (تشفير الصوت E2EE)
            الذي أصبح Discord يفرضه على كل اتصالات الصوت منذ 1 مارس 2026.
            JDA 5.x لا يدعمه => البوت يدخل الروم ثم يُطرد (close code 4017) ثم يعيد المحاولة في Loop.
        -->
        <jda.version>6.7.0</jda.version>

        <!-- libdave-jvm: تنفيذ DAVE يعمل على Java 21 (JDAVE يحتاج Java 25) -->
        <libdave.version>0.1.4</libdave.version>

        <main.class>com.ticketbot.Main</main.class>
    </properties>

    <dependencies>
        <!-- مكتبة Discord -->
        <dependency>
            <groupId>net.dv8tion</groupId>
            <artifactId>JDA</artifactId>
            <version>${jda.version}</version>
        </dependency>

        <!-- ===== DAVE (إلزامي لأي اتصال صوتي) ===== -->
        <dependency>
            <groupId>moe.kyokobot.libdave</groupId>
            <artifactId>adapter-jda</artifactId>
            <version>${libdave.version}</version>
        </dependency>
        <dependency>
            <groupId>moe.kyokobot.libdave</groupId>
            <artifactId>impl-jni</artifactId>
            <version>${libdave.version}</version>
        </dependency>
        <!-- Natives: Windows (Eclipse على جهازك) -->
        <dependency>
            <groupId>moe.kyokobot.libdave</groupId>
            <artifactId>natives-win-x86-64</artifactId>
            <version>${libdave.version}</version>
        </dependency>
        <!-- Natives: Linux (لو شغلت البوت على VPS) -->
        <dependency>
            <groupId>moe.kyokobot.libdave</groupId>
            <artifactId>natives-linux-x86-64</artifactId>
            <version>${libdave.version}</version>
        </dependency>
        <!-- Natives: macOS (Intel + Apple Silicon) -->
        <dependency>
            <groupId>moe.kyokobot.libdave</groupId>
            <artifactId>natives-darwin</artifactId>
            <version>${libdave.version}</version>
        </dependency>

        <!--
            Logging: بدون هذه المكتبة JDA لا يطبع أي خطأ في الـ Console!
            (هذا سبب أنك لم تر أي Error أثناء Loop الصوت)
        -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.18</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- يبني ملف jar واحد فيه كل المكتبات: target/kushticket-2.0.0.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
